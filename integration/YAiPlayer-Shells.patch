+@Composable
+internal fun mobileVizoPalette(): VizoPalette {
+    val stage = LocalStagePalette.current
+    val accent = stageAccent
+    return VizoPalette(
+        stage.page, stage.ink.copy(alpha = 0.075f).compositeOver(stage.page),
+        stage.text, stage.muted, accent.accent, accent.focus,
+    )
+}
+
+@Composable
+internal fun MobileVizoHome(
+    nav: NavHostController,
+    live: LiveViewModel,
+    onSwitchProfile: () -> Unit,
+    onAppearance: () -> Unit,
+) {
+    val groups by live.categories.collectAsStateWithLifecycle()
+    val counts by live.categoryCounts.collectAsStateWithLifecycle()
+    val providers by live.providerNames.collectAsStateWithLifecycle()
+    val home: HomeViewModel = koinViewModel()
+    val resume by home.resume.collectAsStateWithLifecycle()
+    val resumeGate = rememberResumeGate()
+    val liveTuner: LiveTuner = koinInject()
+    val categories = groups.filterNot { it.sealed }.mapNotNull { group ->
+        val title = when (group.key) {
+            LiveKey.All -> stringResource(VizoR.string.vizo_all)
+            LiveKey.History -> stringResource(VizoR.string.vizo_history)
+            LiveKey.Favorites -> stringResource(VizoR.string.vizo_favorites)
+            LiveKey.Catchup -> stringResource(VizoR.string.vizo_archive)
+            else -> group.title
+        } ?: return@mapNotNull null
+        VizoCategory(group.key.serialize(), title, counts[group.key])
+    }
+    fun open(route: String) = nav.navigate(route) { launchSingleTop = true }
+    VizoHome(
+        palette = mobileVizoPalette(),
+        television = false,
+        categories = categories,
+        hasSources = providers.isNotEmpty(),
+        canContinue = resume != null,
+        onAppearance = onAppearance,
+        onCategory = { id ->
+            groups.firstOrNull { !it.sealed && it.key.serialize() == id }?.let {
+                live.select(it.key)
+                open(MobileDestination.LIVE.route)
+            }
+        },
+        onAction = { action ->
+            when (action) {
+                VizoAction.CONTINUE -> resume?.let { target ->
+                    when (target.type) {
+                        MediaType.MOVIE -> resumeGate(target.positionMs) { position ->
+                            home.playMovie(target.itemId, position) { open(PLAYER_ROUTE) }
+                        }
+                        MediaType.EPISODE -> resumeGate(target.positionMs) { position ->
+                            home.playEpisode(target.itemId, position) { open(PLAYER_ROUTE) }
+                        }
+                        else -> {
+                            liveTuner.tune(target.itemId)
+                            open(PLAYER_ROUTE)
+                        }
+                    }
+                }
+                VizoAction.ACCOUNT -> onSwitchProfile()
+                VizoAction.REMOTE -> open(MoreLeaf.REMOTE.route)
+                VizoAction.SEARCH -> open(SEARCH_ROUTE)
+                VizoAction.GUIDE -> open(MobileDestination.GUIDE.route)
+                VizoAction.PLAYLISTS -> open(SettingsLeaf.PLAYLISTS.route)
+                VizoAction.GUIDE_SOURCES -> open(SettingsLeaf.EPG_SOURCES.route)
+                VizoAction.SETTINGS -> open(MobileDestination.SETTINGS.route)
+            }
+        },
+        onAddSource = { source ->
+            val entry = when (source) {
+                VizoSource.M3U -> SetupEntry.M3U
+                VizoSource.XTREAM -> SetupEntry.XTREAM
+                VizoSource.STALKER -> SetupEntry.STALKER
+            }
+            open(setupRoute(entry))
+        },
+    )
+}
