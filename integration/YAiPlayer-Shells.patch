@@ -0,0 +1,68 @@
+package tv.own.owntv.features.shell
+
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.getValue
+import androidx.compose.runtime.produceState
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.focus.FocusRequester
+import androidx.compose.ui.platform.LocalContext
+import androidx.compose.ui.res.stringResource
+import androidx.lifecycle.compose.collectAsStateWithLifecycle
+import app.yai.shells.vizo.R as VizoR
+import app.yai.shells.vizo.VizoProgramme
+import app.yai.shells.vizo.VizoSchedule
+import java.util.Date
+import tv.own.owntv.core.database.entity.ChannelEntity
+import tv.own.owntv.core.database.entity.EpgProgrammeEntity
+import tv.own.owntv.features.live.LiveViewModel
+
+@Composable
+internal fun TvVizoSchedule(
+    channel: ChannelEntity,
+    live: LiveViewModel,
+    onFullScreen: () -> Unit,
+    modifier: Modifier = Modifier,
+    firstFocus: FocusRequester,
+    onReplayStarted: (() -> Unit)? = null,
+) {
+    val playing by live.nowNext.collectAsStateWithLifecycle()
+    val schedule by produceState(emptyList<EpgProgrammeEntity>(), channel, playing?.now?.startMs) {
+        value = emptyList()
+        val now = System.currentTimeMillis()
+        value = live.pastProgrammes(channel, now - 2 * HOUR, now + 24 * HOUR)
+    }
+    val archives by produceState(emptySet<Long>(), channel, playing?.now?.startMs) {
+        value = emptySet()
+        if (channel.catchup) value = live.catchupProgrammes(channel).mapTo(mutableSetOf()) { it.id }
+    }
+    val context = LocalContext.current
+    val timeFormat = android.text.format.DateFormat.getTimeFormat(context)
+    val dateFormat = android.text.format.DateFormat.getDateFormat(context)
+    val clock = System.currentTimeMillis()
+    val today = dateFormat.format(Date(clock))
+    val rows = schedule.map { programme ->
+        val startDate = Date(programme.startMs)
+        val day = dateFormat.format(startDate)
+        val times = stringResource(VizoR.string.vizo_time_range, timeFormat.format(startDate), timeFormat.format(Date(programme.stopMs)))
+        VizoProgramme(
+            id = programme.id,
+            title = programme.title,
+            time = if (day == today) times else stringResource(VizoR.string.vizo_dated_time, day, times),
+            onNow = programme.startMs <= clock && programme.stopMs > clock,
+            canReplay = programme.id in archives && programme.stopMs <= clock,
+        )
+    }
+    VizoSchedule(
+        channel.name, rows, tvVizoPalette(), onFullScreen,
+        onReplay = { id ->
+            schedule.firstOrNull { it.id == id && it.id in archives }?.let {
+                live.playCatchupProgramme(channel, it)
+                onReplayStarted?.invoke()
+            }
+        },
+        modifier = modifier,
+        firstFocus = firstFocus,
+    )
+}
+
+private const val HOUR = 3_600_000L
