+
+@Composable
+internal fun TvVizoHome(
+    live: LiveViewModel,
+    hasSources: Boolean,
+    canContinue: Boolean,
+    firstFocus: FocusRequester,
+    onAppearance: () -> Unit,
+    onCategory: (LiveKey) -> Unit,
+    onAction: (VizoAction) -> Unit,
+    onAddSource: (SourceType) -> Unit,
+    modifier: Modifier = Modifier,
+) {
+    val groups by live.railItems.collectAsStateWithLifecycle()
+    val counts by live.railCounts.collectAsStateWithLifecycle()
+    val categories = groups.filterNot { it.sealed }.mapNotNull { group ->
+        val title = when (group.key) {
+            LiveKey.All -> stringResource(VizoR.string.vizo_all)
+            LiveKey.History -> stringResource(VizoR.string.vizo_history)
+            LiveKey.Favorites -> stringResource(VizoR.string.vizo_favorites)
+            LiveKey.Catchup -> stringResource(VizoR.string.vizo_archive)
+            else -> group.title
+        } ?: return@mapNotNull null
+        VizoCategory(group.key.serialize(), title, counts[group.key])
+    }
+    VizoHome(
+        palette = tvVizoPalette(),
+        television = true,
+        categories = categories,
+        hasSources = hasSources,
+        canContinue = canContinue,
+        onAppearance = onAppearance,
+        onCategory = { id -> groups.firstOrNull { !it.sealed && it.key.serialize() == id }?.let { onCategory(it.key) } },
+        onAction = onAction,
