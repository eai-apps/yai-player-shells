+            onAddSource(when (it) {
+                VizoSource.M3U -> SourceType.M3U
+                VizoSource.XTREAM -> SourceType.XTREAM
+                VizoSource.STALKER -> SourceType.STALKER
+            })
+        },
+        modifier = modifier,
+        firstFocus = firstFocus,
+    )
+}
